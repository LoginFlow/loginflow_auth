<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility for Custom Tabs providers (Android 11+). The app
         adds its own <queries> entries for sibling SSO providers. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
